{
  "name": "sudokublitz",
  "version": "1.0.0",
  "description": "A high-performance TypeScript Sudoku engine built for speed and precision.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./workers/*": "./dist/workers/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "prepublishOnly": "npm run test && npm run build"
  },
  "keywords": [
    "sudoku",
    "solver",
    "generator",
    "typescript",
    "webworker",
    "high-performance",
    "bitmask",
    "sudokublitz"
  ],
  "author": "iliyto",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iliyto/sudokublitz.git"
  },
  "bugs": {
    "url": "https://github.com/iliyto/sudokublitz/issues"
  },
  "homepage": "https://github.com/iliyto/sudokublitz#readme",
  "devDependencies": {
    "eslint": "^9.0.0",
    "prettier": "^3.8.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^1.6.1"
  }
}